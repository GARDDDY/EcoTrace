<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="15dp"
    android:orientation="horizontal" >

    <LinearLayout
        android:id="@+id/goto_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/user_img_found_layout"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:srcCompat="@drawable/baseline_person_24" />

        <TextView
            android:id="@+id/username_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:text="username"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/userRankImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="5dp"
            tools:srcCompat="@drawable/baseline_circle_24" />

        <TextView
            android:id="@+id/userRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:text="1000" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/tagsInfoLayout"
        android:layout_below="@id/goto_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tagsChipGroup"
            android:layout_width="wrap_content"
            app:singleLine="true"
            android:layout_height="wrap_content">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Трудолюбивый"/>

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Трудолюбивый"/>

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Трудолюбивый"/>

        </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/alsoTagsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+5"
                android:textSize="20sp"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="15dp"
                android:layout_toEndOf="@id/tagsChipGroup"/>

        </RelativeLayout>
    </HorizontalScrollView>



    <RelativeLayout
        android:id="@+id/commonGroupsLayout"
        android:layout_width="match_parent"
        android:layout_below="@id/tagsInfoLayout"
        android:layout_marginVertical="10dp"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/commonGroupsVectorImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/round_family_restroom_24" />

        <TextView
            android:id="@+id/commonGroups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_toEndOf="@id/commonGroupsVectorImage"
            android:text="1 общая группа" />

        <TextView
            android:id="@+id/delimiter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="●"
            android:layout_toEndOf="@id/commonGroups"
            android:layout_marginHorizontal="15dp" />

        <ImageView
            android:id="@+id/commonEventsVectorImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/baseline_reduce_capacity_24"
            android:layout_toEndOf="@id/delimiter1"/>

        <TextView
            android:id="@+id/commonEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_toEndOf="@id/commonEventsVectorImage"
            android:text="1 общее мероприятие" />
    </RelativeLayout>

</RelativeLayout>