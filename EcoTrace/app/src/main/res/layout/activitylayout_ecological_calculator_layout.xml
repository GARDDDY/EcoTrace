<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/testQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/ok_green"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Test Question" />

    <TextView
        android:id="@+id/specifyData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_specify_chip"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/specifyValues"
        android:textColor="@color/ok_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/currentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:inputType="numberSigned"
            android:minWidth="72dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/ok_green"
            android:textSize="44sp"
            android:textStyle="bold"
            tools:text="0" />

        <TextView
            android:id="@+id/valueTypeToCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/ok_green"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="valueType" />
    </LinearLayout>

    <TextView
        android:id="@+id/currentValueSpecify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ok_green"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="current" />

    <TextView
        android:id="@+id/valueTypeToCurrentSpecify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ok_green"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="valueType" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:progressBackgroundTint="@color/dirt2_white"
        android:progressTint="@color/ok_green"
        android:thumbTint="@color/ok_green" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/silver"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="min" />

            <TextView
                android:id="@+id/valueTypeToMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/silver"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="valueType" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/maxValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/silver"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="max" />

            <TextView
                android:id="@+id/valueTypeToMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/silver"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="valueType" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/hintUsedSpecify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/nowUsingSpecifiedData"
        android:textColor="@color/silver"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hintToUseGeneral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dragToUseGeneralData"
        android:textColor="@color/silver"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
