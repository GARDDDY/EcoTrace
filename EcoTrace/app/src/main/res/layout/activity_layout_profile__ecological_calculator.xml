<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Фильтры графика — всегда доступны, даже если под текущим фильтром нет данных. -->
    <LinearLayout
        android:id="@+id/graphControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/graphTypesChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/default_PaddingMargin"
            app:chipSpacingHorizontal="6dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFood"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/food"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWater"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/water"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTrash"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/trash"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnergy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/energy"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransport"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/transport"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/graphPeriodToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="@dimen/default_PaddingMargin"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/period7Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/by7days"
                android:textColor="@color/selector_chip_text"
                app:backgroundTint="@color/selector_chip_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/period30Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/by30days"
                android:textColor="@color/selector_chip_text"
                app:backgroundTint="@color/selector_chip_background" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Взаимоисключающие состояния: нет данных / график / загрузка. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/noEcoDataWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/userHaveNotTakenTestsYet"
            android:textAlignment="center"
            android:textColor="@color/silver"
            android:textSize="16sp"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/chartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@color/dirt2_white"
            android:foreground="@drawable/bottom_rounded_border"
            android:padding="10dp"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/userEcoDataGraph"
                android:layout_width="match_parent"
                android:layout_height="280dp" />
        </RelativeLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/userEcoDataInformationLayoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingVertical="10dp"
            app:shimmer_auto_start="true"
            app:shimmer_clip_to_children="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:adjustViewBounds="true"
                android:foreground="@drawable/layout_loading_shimmer"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />
        </com.facebook.shimmer.ShimmerFrameLayout>

    </FrameLayout>

</LinearLayout>
