<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp">

    <TextView
        android:id="@+id/noEventsWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/userHaveNotTakenPartInAnyEventYet"
        android:textAlignment="center"
        android:textColor="@color/silver"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/eventsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/userEventsInformationLayoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingVertical="10dp"
        app:shimmer_auto_start="true"
        app:shimmer_clip_to_children="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/mrl1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:foreground="@drawable/bottom_rounded_border"
                android:paddingBottom="@dimen/default_PaddingMargin"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_marginBottom="15dp"
                android:background="@color/dirt_white"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/en1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="bottom"
                    android:text="Event-name"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:textSize="18sp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/ok_green"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:id="@+id/etsv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/en1"
                    android:layout_margin="@dimen/default_PaddingMargin"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/et1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                    </LinearLayout>
                </HorizontalScrollView>

                <RelativeLayout
                    android:id="@+id/sl1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv1"
                    android:layout_marginStart="15dp"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/esvi1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/baseline_access_time_24" />

                    <TextView
                        android:id="@+id/es1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/esvi1"
                        android:text="Event-status"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ml1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv1"
                    android:layout_toEndOf="@id/sl1"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/emvi1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/default_PaddingMargin"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/baseline_people_24" />

                    <TextView
                        android:id="@+id/em1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/emvi1"
                        android:text="eventMembers"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv1"
                    android:layout_toEndOf="@id/ml1"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ervi1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/default_PaddingMargin"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/outline_account_circle_24" />

                    <TextView
                        android:id="@+id/er1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ervi1"
                        android:text="1000"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/le1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_below="@id/ml1"
                    android:visibility="gone"
                    android:backgroundTint="@color/dirt_white"
                    app:strokeColor="@color/ok_green"
                    android:clickable="true"
                    app:strokeWidth="2dp"
                    android:textColor="@color/ok_green"
                    android:text="Покинуть" />


            </RelativeLayout >

            <RelativeLayout
                android:id="@+id/mrl2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:foreground="@drawable/bottom_rounded_border"
                android:paddingBottom="@dimen/default_PaddingMargin"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_marginBottom="15dp"
                android:background="@color/dirt_white"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/en2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="bottom"
                    android:text="Event-name"
                    android:textSize="18sp"
                    android:layout_marginHorizontal="10dp"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/ok_green"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:id="@+id/etsv2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/en2"
                    android:layout_margin="@dimen/default_PaddingMargin"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/et2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:foreground="@drawable/layout_loading_shimmer"
                            android:text="TextView1-Event" />

                    </LinearLayout>
                </HorizontalScrollView>

                <RelativeLayout
                    android:id="@+id/sl2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv2"
                    android:layout_marginStart="15dp"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/esvi2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/baseline_access_time_24" />

                    <TextView
                        android:id="@+id/es2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/esvi2"
                        android:text="Event-status"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ml2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv2"
                    android:layout_toEndOf="@id/sl2"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/emvi2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/default_PaddingMargin"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/baseline_people_24" />

                    <TextView
                        android:id="@+id/em2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/emvi2"
                        android:text="eventMembers"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etsv2"
                    android:layout_toEndOf="@id/ml2"
                    android:foreground="@drawable/layout_loading_shimmer"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ervi2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/default_PaddingMargin"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/outline_account_circle_24" />

                    <TextView
                        android:id="@+id/er2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ervi2"
                        android:text="1000"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/le2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_below="@id/ml2"
                    android:backgroundTint="@color/dirt_white"
                    app:strokeColor="@color/ok_green"
                    android:clickable="true"
                    android:visibility="gone"
                    app:strokeWidth="2dp"
                    android:textColor="@color/ok_green"
                    android:text="Покинуть" />


            </RelativeLayout >
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>
