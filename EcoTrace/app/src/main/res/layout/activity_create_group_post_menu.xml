<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dirt_white"
    android:fitsSystemWindows="true"
    tools:context=".ui.more.groups.CreateGroupPostMenuActivity">

    <android.widget.Toolbar
        android:id="@+id/toolbar8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/publishPost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/publishPost"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/default_PaddingMargin"
        android:enabled="false"
        android:minWidth="120dp"
        android:text="@string/publish"
        android:textColor="@color/white"
        app:backgroundTint="@color/selector_publish_background"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="@id/toolbar8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/toolbar8" />

    <ProgressBar
        android:id="@+id/publishProgress"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminateTint="@color/ok_green"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/publishPost"
        app:layout_constraintEnd_toEndOf="@id/publishPost"
        app:layout_constraintStart_toStartOf="@id/publishPost"
        app:layout_constraintTop_toTopOf="@id/publishPost" />

    <ImageView
        android:id="@+id/userImage"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/default_PaddingMargin"
        android:layout_marginTop="@dimen/default_PaddingMargin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar8"
        app:srcCompat="@drawable/baseline_person_24" />

    <TextView
        android:id="@+id/textView58"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="@dimen/default_PaddingMargin"
        android:text="@string/postToTheGroup"
        android:textColor="@color/silver"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/userImage"
        app:layout_constraintTop_toTopOf="@id/userImage" />

    <TextView
        android:id="@+id/currentGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ok_green"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/userImage"
        app:layout_constraintTop_toBottomOf="@id/textView58"
        tools:text="groupName" />

    <ScrollView
        android:id="@+id/postContentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/default_PaddingMargin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userImage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/default_PaddingMargin">

            <EditText
                android:id="@+id/postTextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="@string/writeSomething..."
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="120dp"
                android:textColor="@color/black"
                android:textColorHint="@color/silver"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/charCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:textColor="@color/silver"
                android:textSize="12sp"
                tools:text="0 / 2000" />

            <HorizontalScrollView
                android:id="@+id/postImagesScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_PaddingMargin"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/postImagesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.chip.Chip
                android:id="@+id/attachImageChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_PaddingMargin"
                android:text="@string/image"
                android:textColor="@color/ok_green"
                app:chipBackgroundColor="@color/dirt2_white"
                app:chipIcon="@drawable/baseline_image_24"
                app:chipIconTint="@color/ok_green" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
