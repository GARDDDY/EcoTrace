<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_PaddingMargin">

    <TextView
        android:id="@+id/blockTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ok_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/dirt2_white"
        android:foreground="@drawable/bottom_rounded_border"
        android:padding="10dp">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/blockChart"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/blockAdvices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

</LinearLayout>
