<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:layout_gravity="center"
    android:paddingBottom="@dimen/default_PaddingMargin">
    <RelativeLayout
        android:id="@+id/mainRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:foreground="@drawable/bottom_rounded_border"
        android:paddingBottom="@dimen/default_PaddingMargin"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:background="@color/dirt_white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/groupImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:foreground="#A0000000"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/groupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/groupImage"
            android:layout_marginBottom="10dp"
            android:gravity="bottom"
            android:text="Group-name\n"
            android:textSize="18sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="10dp"
            android:textColor="@color/dirt_white"
            android:textStyle="bold"/>

        <RelativeLayout
            android:id="@+id/someGroupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_below="@+id/groupImage">

            <ImageView
                android:id="@+id/groupMembersVectorImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_people_24"/>

            <TextView
                android:id="@+id/groupMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/groupMembersVectorImage"
                android:textColor="@color/black"
                android:text="-1"
                android:layout_centerVertical="true"
                android:textSize="14sp" />

            <View
                android:id="@+id/delimiter1"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_toEndOf="@id/groupMembers"
                android:layout_marginHorizontal="15dp"/>

            <ImageView
                android:id="@+id/groupRoleVectorImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_toEndOf="@id/delimiter1"
                app:srcCompat="@drawable/outline_account_circle_24" />

            <TextView
                android:id="@+id/groupRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/groupRoleVectorImage"
                android:textColor="@color/black"
                android:text="groupRole"
                android:layout_centerVertical="true"
                android:textSize="14sp" />

        </RelativeLayout>

        <TextView
            android:id="@+id/groupDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/someGroupInfo"
            android:textColor="@color/black"
            android:maxLines="2"
            android:ellipsize="end"
            android:hint="@string/noDescription"
            android:textSize="14sp"
            android:textColorHint="@color/silver"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="@dimen/default_PaddingMargin"
            android:text="group-description" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/leaveGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/dirt_white"
            app:strokeColor="@color/ok_green"
            android:clickable="true"
            app:strokeWidth="2dp"
            android:textColor="@color/ok_green"
            android:layout_below="@id/groupDescription"
            android:text="Покинуть" />

    </RelativeLayout >
</FrameLayout>
