<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/default_PaddingMargin">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Место числом (4+) либо медаль (1-3) — занимают один и тот же слот фиксированной
             ширины, чтобы аватар не сдвигался в зависимости от того, что показано. -->
        <TextView
            android:id="@+id/userPlace"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_centerVertical="true"
            android:textSize="18sp"
            android:layout_alignParentStart="true"
            android:text="0" />

        <ImageView
            android:id="@+id/userMedal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:visibility="invisible"
            tools:srcCompat="@drawable/round_looks_one_24" />

        <ImageView
            android:id="@+id/userImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:layout_marginHorizontal="@dimen/default_PaddingMargin"
            android:layout_toEndOf="@id/userPlace"
            android:layout_centerVertical="true"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ok_green"
            android:textSize="20sp"
            android:layout_toEndOf="@id/userImage"
            android:layout_centerVertical="true"
            android:paddingHorizontal="@dimen/default_PaddingMargin"
            android:text="username" />

        <!-- Флаг страны — только если country_code пришёл (бэк уже сам не отдаёт его,
             когда country_visibility скрыт). -->
        <TextView
            android:id="@+id/userCountryFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/username"
            android:layout_centerVertical="true"
            android:textSize="18sp"
            android:visibility="gone"
            tools:text="🏳" />

        <TextView
            android:id="@+id/userExperience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/userCountryFlag"
            android:paddingHorizontal="@dimen/default_PaddingMargin"
            android:gravity="center"
            android:textColor="@color/ok_green"
            android:layout_centerVertical="true"
            android:textSize="20sp"
            android:layout_marginHorizontal="@dimen/default_PaddingMargin"
            android:text="experience" />


    </RelativeLayout>
</FrameLayout>