<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/specifyItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="Курица" />

        <TextView
            android:id="@+id/specifyItemValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ok_green"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="120 гр." />
    </LinearLayout>

    <SeekBar
        android:id="@+id/specifyItemSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressBackgroundTint="@color/dirt2_white"
        android:progressTint="@color/ok_green"
        android:thumbTint="@color/ok_green" />

</LinearLayout>
