<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clickable="true"
    android:paddingBottom="@dimen/default_PaddingMargin">
    <RelativeLayout
        android:id="@+id/mainRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:foreground="@drawable/bottom_rounded_border"
        android:paddingBottom="@dimen/default_PaddingMargin"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:background="@color/dirt_white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="bottom"
            android:text="Event-name"
            android:textSize="25sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/ok_green"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:id="@+id/eventTagsScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/default_PaddingMargin"
            android:scrollbars="none"
            android:layout_below="@+id/eventName">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/eventTags"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleLine="true"
                android:orientation="horizontal" >

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <RelativeLayout
            android:id="@+id/statusLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_below="@+id/eventTagsScrollView"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/eventStatusVectorImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/baseline_access_time_24" />

            <TextView
                android:id="@+id/eventStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/eventStatusVectorImage"
                android:text="eventStatus"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/membersLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/eventTagsScrollView"
            android:layout_toEndOf="@id/statusLayout"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/eventMembersVectorImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/default_PaddingMargin"
                android:layout_marginEnd="10dp"
                app:srcCompat="@drawable/baseline_people_24" />

            <TextView
                android:id="@+id/eventMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eventMembers"
                android:textColor="@color/black"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/eventMembersVectorImage"
                android:textSize="15sp" />
        </RelativeLayout>


    </RelativeLayout >
</FrameLayout>